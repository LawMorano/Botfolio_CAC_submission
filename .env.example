# Copy this file to `.env` and fill in the values.
#   Windows:  copy .env.example .env
#   Mac/Linux: cp .env.example .env
#
# NOTHING HERE IS REQUIRED TO RUN THE APP.
# Without an API key the site works normally; only the "Get AI feedback"
# button is disabled, and it says so on screen instead of crashing.

# OpenAI powers the narrowly scoped, moderated FTC design review.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Official FIRST Events API credentials power FRC team-number lookups.
# Register at https://frc-events.firstinspires.org/services/API/register.
FRC_API_USERNAME=
FRC_API_TOKEN=
# Optional; defaults to the current calendar year.
FRC_API_SEASON=

# Used to sign session cookies. Any random string works for local development.
# A throwaway dev key is generated automatically if you leave this blank.
FLASK_SECRET_KEY=

# EmailJS transactional email settings.
# Find the Public Key in EmailJS Dashboard -> Account.
EMAILJS_SERVICE_ID=service_jsf8u6m
EMAILJS_TEMPLATE_ID=template_8mvmlqq
EMAILJS_PUBLIC_KEY=
# Required for this server-side integration because EmailJS strict API mode is
# enabled. Never expose this value in HTML or browser JavaScript.
EMAILJS_PRIVATE_KEY=
BOTFOLIO_FROM_EMAIL=noreply@botfoliohq.com
BOTFOLIO_FROM_NAME=Botfolio

# Sign in with Google. Leave all three blank and the feature is simply off:
# the button is not rendered and its routes 404, exactly as before it existed.
# Create an OAuth 2.0 Client ID of type "Web application" at
# https://console.cloud.google.com/apis/credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match a URI registered on that client byte for byte, including the
# scheme and any trailing path. Locally that is
#   http://localhost:8080/auth/google/callback
# and in production https://botfoliohq.com/auth/google/callback. Register both
# on the same client and set this per environment.
GOOGLE_REDIRECT_URI=

# =====================================================================
# DEPLOYMENT SETTINGS
#
# Everything below this line is for running Botfolio on a server. Leave
# the whole section blank on your laptop — each one falls back to the
# local behaviour the app has always had. Read them in infra/settings.py.
# =====================================================================

# Which deployment this is: development, staging, or production.
# Controls whether HTTPS is forced and whether logs are JSON.
# Railway sets RAILWAY_ENVIRONMENT_NAME on its own, so you can skip this there.
APP_ENV=

# --- Database --------------------------------------------------------
# Blank = the SQLite file, which is correct locally.
# Set = Postgres (Railway's plugin or an AWS RDS instance). infra/database.py
# translates this app's SQLite SQL on the way through, so nothing else changes.
#   postgresql://user:password@host:5432/botfolio
DATABASE_URL=

# --- Uploads ---------------------------------------------------------
# The one that actually matters in production. Containers on Railway and ECS
# get a fresh, empty disk on every deploy: without a bucket, every photo and
# STL anyone has ever uploaded is deleted the next time you push. Set this and
# uploads go to S3 instead, where they survive.
# Prefer three separately permissioned R2 buckets. S3_BUCKET remains a
# backwards-compatible fallback for older single-bucket deployments.
S3_BUCKET=
S3_BUCKET_IMAGES=botfolio-images
S3_BUCKET_MODELS=botfolio-models
S3_BUCKET_QUARANTINE=botfolio-quarantine
AWS_REGION=us-east-1
# Only if uploads are served through CloudFront rather than straight from
# the bucket. Also how you point at MinIO in a local docker-compose.
S3_PUBLIC_URL=
S3_IMAGES_PUBLIC_URL=https://assets.botfoliohq.com
S3_ENDPOINT_URL=
# Credentials: on ECS these come from the task role automatically and should
# be left blank. On Railway there is no role, so an IAM user's keys go here.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Cache and rate limiting -----------------------------------------
# Both work without Redis, holding their state inside the process. That is
# fine on one container. With two or more, each keeps its own counters and
# the real rate limit becomes double what you configured — set this then.
REDIS_URL=
CACHE_SECONDS=30
CACHE_ENABLED=true
RATELIMIT_ENABLED=true

# --- Logging and metrics ---------------------------------------------
LOG_LEVEL=INFO
# One JSON object per line, so CloudWatch and Railway can filter on fields.
# Defaults to on in staging/production and off locally.
LOG_JSON=
# Requests slower than this get a warning with their endpoint and duration.
SLOW_REQUEST_MS=1000
# /metrics is public-facing, so it stays hidden unless this is set. Then it
# needs `Authorization: Bearer <token>`. Any long random string works.
METRICS_TOKEN=

# Optional. Discord webhook for posting newly published designs to #showcase.
# Treat this value as a secret and configure it in the deployment dashboard.
DISCORD_SHOWCASE_WEBHOOK_URL=

# --- Transport security ----------------------------------------------
# The proxy terminates TLS, so the app itself sees plain HTTP and has to
# trust X-Forwarded-Proto. Both default correctly from APP_ENV; override
# only if something is wrong.
BEHIND_PROXY=
FORCE_HTTPS=
HSTS_SECONDS=
